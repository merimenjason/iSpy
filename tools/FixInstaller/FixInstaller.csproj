<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build after putting the iSpy build outputs in payload/x64.zip and payload/x86.zip
       (see .github/workflows/build.yml). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>iSpy-Fix-Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Product>iSpy fixes</Product>
    <Version>1.0.0</Version>
    <!-- Overridden by CI with the branch and commit -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">local build</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="payload/x64.zip" LogicalName="payload.x64.zip" />
    <EmbeddedResource Include="payload/x86.zip" LogicalName="payload.x86.zip" />
  </ItemGroup>
</Project>
